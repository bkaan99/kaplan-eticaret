{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaplan-eticaret",
  "main": "workers/app-worker.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "placement": {
    "mode": "smart"
  },
  // Workers Caching: Cache-Control / CDN-Cache-Control yanıt başlıklarına göre edge cache.
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare Images: /_next/image boyutlandırma + WebP/AVIF. Binding yoksa orijinal dosya döner.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      // Prod maliyet/overhead: %5 örnekleme (staging’de geçici olarak 1 yapılabilir)
      "head_sampling_rate": 0.05
    }
  },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "NODE_ENV": "production",
    // Staging adresi; kendi alan adı bağlanınca (routes) burası ve Auth/e-posta bağlantıları güncellenmeli.
    "APP_URL": "https://kaplan-eticaret.bilgekagangurgen.workers.dev",
    // env.ts şeması zorunlu tuttuğu için yer tutucu; veritabanı D1 binding'inden okunur.
    "DATABASE_URL": "file:./unused",
    // Yerel/dev SMTP yer tutucuları (Workers queue consumer Resend kullanır → RESEND_API_KEY secret).
    "SMTP_HOST": "localhost",
    "SMTP_PORT": "1025",
    "MAIL_FROM": "Kaplan Turşu <no-reply@kaplantursu.com>",
    // R2 public (r2.dev). Kendi alan adında R2 custom domain bağlayınca burayı güncelleyin.
    "UPLOADS_PUBLIC_BASE_URL": "https://pub-dd08ce634607423dbc1eca3011d2c210.r2.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFvl5QAAi-Eo6q6D"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaplan-eticaret",
      "database_id": "e0697813-ccc2-4594-b6db-b45953a0d85f",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "kaplan-eticaret-uploads"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "kaplan-eticaret-next-cache"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "kaplan-eticaret-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "kaplan-eticaret-jobs",
        "max_batch_size": 10,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *", "30 3 * * *"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kaplan-eticaret"
    }
  ]
}
