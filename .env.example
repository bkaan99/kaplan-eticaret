# Uygulama
APP_URL=http://localhost:3000
# En az 32 karakter. Üretmek için: openssl rand -base64 32
AUTH_SECRET=

# Veritabanı (docker-compose.yml ile uyumlu)
# Docker portu; 5432 başka bir PostgreSQL tarafından kullanılıyorsa değiştirin
DB_PORT=5432
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce
# İsteğe bağlı: entegrasyon testleri için ayrı veritabanı (yoksa DATABASE_URL + _test)
# TEST_DATABASE_URL=postgresql://kullanici:parola@localhost:5432/ecommerce_test

# E-posta (geliştirmede Mailpit: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mağaza <no-reply@localhost>"

# Ödeme (PayTR) — boşsa geliştirmede sahte ödeme sağlayıcısı kullanılır, production'da zorunlu
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=false

# Dosya yükleme dizini (varsayılan ./uploads; production'da kalıcı volume olmalı)
UPLOAD_DIR=

# ERP (features.erp açıkken zorunlu)
ERP_STOCK_URL=
ERP_API_KEY=

# Cloudflare Turnstile (features.captcha açıkken zorunlu)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analitik (çerez onayı verilince yüklenir)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
