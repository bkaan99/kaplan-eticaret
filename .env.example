# Uygulama
APP_URL=http://localhost:3000
# En az 32 karakter. Üretmek için: openssl rand -base64 32
AUTH_SECRET=

# Veritabanı — SQLite (Cloudflare D1 ile aynı diyalekt)
DATABASE_URL=file:./dev.db
# İsteğe bağlı: entegrasyon testleri (yoksa bellekte ayrı dosya)
# TEST_DATABASE_URL=file:./test.db

# Cloudflare Cron Trigger'ların çağırdığı /api/cron/* uçları için
# CRON_SECRET=

# E-posta (geliştirmede Mailpit: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mağaza <no-reply@localhost>"

# Ödeme (PayTR) — boşsa geliştirmede sahte ödeme sağlayıcısı kullanılır, production'da zorunlu
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=false

# Dosya yükleme dizini (varsayılan ./uploads; production'da kalıcı volume olmalı)
UPLOAD_DIR=
# Production R2 public kök (r2.dev veya custom domain). Boşsa /uploads proxy.
# UPLOADS_PUBLIC_BASE_URL=https://pub-….r2.dev
# CF_IMAGE_RESIZING=true

# Cloudflare Turnstile (features.captcha açıkken zorunlu)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Workers queue e-posta (Resend). Yerelde SMTP kullanılır.
# RESEND_API_KEY=

# Analitik (çerez onayı verilince yüklenir)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
