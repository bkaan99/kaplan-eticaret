{
  "name": "e-commerce-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:d1-migrate-local": "wrangler d1 migrations apply kaplan-eticaret --local",
    "db:seed-remote": "tsx scripts/seed-remote-d1.ts",
    "worker": "tsx --conditions react-server src/worker/index.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/prune-opennext-bundle.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "init-project": "tsx scripts/init-project.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.7",
    "motion": "14.2.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.156.0"
  }
}
