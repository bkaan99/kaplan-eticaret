{
  "name": "e-commerce-template",
  "version": "1.0.4",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "tsx scripts/seed.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/guard-deploy.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "init-project": "tsx scripts/init-project.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test:e2e": "playwright test",
    "db:migrate-local": "wrangler d1 migrations apply kaplan-eticaret --local --config wrangler.scripts.jsonc",
    "db:migrate-remote": "wrangler d1 migrations apply kaplan-eticaret --remote",
    "db:seed-remote": "tsx scripts/seed.ts --remote"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.7",
    "drizzle-orm": "^0.45.4",
    "motion": "14.2.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.157.0"
  }
}
